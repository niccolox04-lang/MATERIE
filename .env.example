# Esempio di configurazione — NESSUN segreto reale in questo file.
# Copiare in .env (mai committato) per l'esecuzione locale del server/AI.
#
# Porta del server minimale (serve contenuti + gate entitlement server-side)
PORT=3000
# Radice contenuti (default: directory corrente / materie)
CONTENT_ROOT=.
# Chiave per eventuale LLM compatibile OpenAI (AI avanzata ULTRA).
# Se assente, l'AI opera SOLO in retrieval locale estrattivo e lo dichiara.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
