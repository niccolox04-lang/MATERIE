{
  "name": "mappe-didattiche",
  "version": "0.1.0",
  "description": "Piattaforma didattica a knowledge-graph: mappe concettuali gerarchiche per materia. Core senza dipendenze di produzione.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:index": "node scripts/build-index.mjs",
    "coverage": "node scripts/coverage.mjs",
    "import:md": "node scripts/import-markdown.mjs --help",
    "new:subject": "node scripts/new-subject.mjs --help",
    "serve": "node src/server/server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "UNLICENSED",
  "private": true
}
